# =============================================================================
# Play — variables de entorno del frontend (@play/web)
# Copia este fichero a `apps/web/.env` si necesitas sobrescribir los valores.
# IMPORTANTE: Vite incrusta estas variables EN TIEMPO DE BUILD; reinicia el
# servidor de desarrollo tras cambiarlas.
# =============================================================================

# Base de la API para fetch.
# Vacío ("") = mismo origen. En desarrollo, el proxy de Vite redirige /api al
# servidor (VITE_PROXY_TARGET). En producción, déjalo vacío si frontend y API
# comparten dominio; si no, pon el dominio de la API (p. ej. https://api.ejemplo.com).
VITE_API_BASE_URL=

# URL del servidor de socket.io (el servidor usa path "/ws").
# Vacío ("") = window.location.origin (mismo origen).
VITE_WS_URL=

# Timeout de arranque del reproductor de YouTube (ms).
VITE_PLAYER_START_TIMEOUT_MS=15000

# SOLO desarrollo: destino del proxy de Vite para /api y /ws.
VITE_PROXY_TARGET=http://localhost:4000
