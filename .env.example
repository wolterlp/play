# =============================================================================
# Play — variables de entorno del servidor (apps/server)
# Copia este fichero a `apps/server/.env` y ajusta los valores
# (dotenv lo carga desde el directorio de trabajo de apps/server).
# La plantilla NO contiene secretos reales.
# Fuente de verdad: apps/server/src/config.ts (validado con zod al arrancar).
# =============================================================================

# --- Entorno ----------------------------------------------------------------
# development | test | production
NODE_ENV=development

# --- Servidor HTTP + WebSocket ----------------------------------------------
HOST=0.0.0.0
PORT=4000

# Orígenes permitidos, separados por coma (CORS + handshake de socket.io).
# En desarrollo apunta al Vite local; en producción, al dominio real.
CORS_ORIGINS=http://localhost:5173

# URL pública de la app web (esquema + host, sin barra final) para construir
# enlaces de invitación absolutos. Si se omite, se deduce del origen de cada
# petición (útil tras un proxy inverso con cabeceras correctas).
# Ejemplo en producción: PUBLIC_URL=https://play.example.com
# PUBLIC_URL=http://localhost:5173

# --- Base de datos (OBLIGATORIA) --------------------------------------------
# En producción añade ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/play

# --- Seguridad (OBLIGATORIA salvo NODE_ENV=test) ----------------------------
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-de-32-caracteres-o-mas

# --- Logging ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Tokens y caducidades (segundos) ----------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INVITE_TTL_SECONDS=604800

# --- Ciclo de vida de salas -------------------------------------------------
# Gracia del anfitrión antes de suspender la sala (RF-01).
HOST_GRACE_SECONDS=120
# Intervalo del vigilante que cierra salas con la gracia vencida (ms).
HOST_SWEEP_INTERVAL_MS=30000
# Duración del estado RECONNECTING tras perder la conexión (segundos).
PRESENCE_RECONNECT_TTL_SECONDS=60

# --- Reproducción -----------------------------------------------------------
# Reintentos por elemento antes de marcarlo FAILED.
MAX_ITEM_RETRIES=2
# Invitaciones activas máximas por sala.
MAX_INVITES_PER_ROOM=50

# --- Rate limiting (peticiones / ventana en ms) -----------------------------
# Login y registro por IP.
AUTH_RATE_MAX=10
AUTH_RATE_WINDOW_MS=60000
# Mensajes WebSocket por usuario.
WS_RATE_MAX=60
WS_RATE_WINDOW_MS=10000
# Crear/resolver invitaciones.
INVITE_RATE_MAX=60
INVITE_RATE_WINDOW_MS=60000
# Salas creadas por usuario.
ROOM_RATE_MAX=10
ROOM_RATE_WINDOW_MS=60000
# ROOM_JOIN por WebSocket (toda unión a sala, con o sin invitación).
JOIN_RATE_MAX=20
JOIN_RATE_WINDOW_MS=60000

# --- Integración con el frontend (opcional, solo desarrollo) ----------------
# El frontend solo necesita VITE_API_BASE_URL y VITE_WS_URL (ver apps/web/.env.example).
